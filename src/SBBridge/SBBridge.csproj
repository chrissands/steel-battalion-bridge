<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows app: .NET Framework 4.8 (built into Windows 10/11) + WebView2 hosting the shared Fluent 2 UI.
       Build on Windows:  dotnet build -c Release src/SBBridge   (CI does this on windows-2022) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SBBridge</AssemblyName>
    <RootNamespace>SBBridge</RootNamespace>
    <Version>1.2.0</Version>
    <Product>Steel Battalion Bridge</Product>
    <ApplicationIcon>../../installer/sbbridge.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <Reference Include="System.Xml" />
    <EmbeddedResource Include="../../web/dist/*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
