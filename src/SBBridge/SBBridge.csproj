<Project Sdk="Microsoft.NET.Sdk">
  <!-- Targets .NET Framework 4.8, which ships with Windows 11: the exe runs with nothing else installed.
       Build:  dotnet build -c Release   (or open in Visual Studio 2022) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>SBBridge</AssemblyName>
    <RootNamespace>SBBridge</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Steel Battalion Bridge</Product>
    <ApplicationIcon>../../installer/sbbridge.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Xml" />
  </ItemGroup>
</Project>
