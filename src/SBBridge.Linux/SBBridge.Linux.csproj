<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux (Bazzite / SteamOS / any distro) build: headless service + browser UI.
       See build-linux.sh for the release (self-contained single-file) publish command. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>sbbridge</AssemblyName>
    <RootNamespace>SBBridge.Linux</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.0</Version>
    <Product>Steel Battalion Bridge</Product>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SBBridge/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../web/dist/*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
